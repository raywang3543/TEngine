.stacklands-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: row;
    color: rgb(28, 30, 28);
}

.left-sidebar {
    width: 18%;
    min-width: 238px;
    height: 100%;
    background-color: rgb(255, 247, 218);
    border-right-width: 5px;
    border-right-color: rgb(25, 27, 25);
    padding: 14px 12px 10px 12px;
}

.panel-title-row { min-height: 62px; flex-direction: row; justify-content: space-between; align-items: flex-start; border-bottom-width: 2px; border-bottom-color: rgb(54, 55, 48); padding-bottom: 8px; }
.panel-title { font-size: 28px; -unity-font-style: bold; }
.panel-count { font-size: 20px; align-self: flex-end; }
.quest-list { flex-grow: 1; margin-top: 12px; margin-bottom: 10px; }
.quest-item { padding: 7px 3px; font-size: 17px; white-space: normal; border-bottom-width: 1px; border-bottom-color: rgba(80, 76, 60, 0.2); }
.quest-complete { color: rgb(63, 118, 67); }
.quest-main { -unity-font-style: bold; }

.card-detail-panel { min-height: 205px; padding: 12px; background-color: rgb(255, 250, 230); border-width: 3px; border-color: rgb(35, 35, 31); }
.detail-title { font-size: 25px; -unity-font-style: bold; margin-bottom: 7px; }
.detail-description { font-size: 17px; white-space: normal; flex-grow: 1; }
.detail-stats { font-size: 16px; margin-top: 6px; }

.right-area { flex-grow: 1; height: 100%; }
.top-shell { height: 14%; min-height: 118px; background-color: rgba(0, 0, 0, 0); }

.hud-strip { position: absolute; right: 12px; top: 15%; height: 42px; flex-direction: row; align-items: center; padding: 5px 8px; background-color: rgba(255, 248, 219, 0.94); border-width: 2px; border-color: rgb(31, 32, 29); border-radius: 5px; }
.hud-label { font-size: 16px; margin: 0 6px; }
.strong { -unity-font-style: bold; }
.speed-button { width: 42px; height: 29px; margin: 0 2px; padding: 2px; background-color: rgb(43, 47, 42); color: white; border-width: 0; }
.speed-active { background-color: rgb(213, 123, 66); }
.small-button { height: 29px; margin-left: 4px; padding: 2px 9px; background-color: rgb(43, 47, 42); color: white; border-width: 0; }
.board-pass-through { flex-grow: 1; }

.modal-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(20, 29, 22, 0.66); }
.modal-card { width: 540px; max-width: 86%; padding: 28px; background-color: rgb(255, 248, 220); border-width: 5px; border-color: rgb(25, 27, 25); border-radius: 14px; }
.modal-title { font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; }
.modal-message { font-size: 19px; white-space: normal; -unity-text-align: middle-center; margin: 16px 0; }
.modal-control { margin: 7px 0; font-size: 17px; }
.modal-list { height: 430px; margin: 8px 0; border-width: 1px; border-color: rgb(92, 89, 75); padding: 5px; }
.cardopedia-entry { padding: 5px 7px; border-bottom-width: 1px; border-bottom-color: rgba(80, 76, 60, 0.18); font-size: 16px; }
.cardopedia-hidden { color: rgb(145, 140, 122); }
.modal-buttons { flex-direction: row; justify-content: center; margin-top: 15px; }
.primary-button, .secondary-button { min-width: 120px; height: 42px; margin: 0 6px; font-size: 17px; border-width: 0; }
.primary-button { color: white; background-color: rgb(55, 90, 58); }
.secondary-button { background-color: rgb(211, 203, 178); }
.toast { position: absolute; top: 22%; align-self: center; max-width: 520px; padding: 12px 24px; background-color: rgba(20, 21, 19, 0.92); color: white; border-radius: 6px; font-size: 18px; }
.hidden { display: none; }
