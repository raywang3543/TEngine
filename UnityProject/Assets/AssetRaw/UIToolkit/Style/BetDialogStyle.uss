/* Bet Dialog Styles */
.dialog-root {
    width: 500px;
    height: 400px;
    background-color: rgb(255, 255, 255);
    border-color: rgb(128, 255, 170);
    border-width: 3px;
    border-radius: 20px;
    padding: 30px;
    align-items: center;
    justify-content: flex-start;
    position: relative;
}

/* 关闭按钮 */
.close-button {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 36px;
    height: 36px;
    background-color: rgb(245, 245, 245);
    border-radius: 18px;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.close-button:hover {
    background-color: rgb(230, 230, 230);
}

.close-icon {
    font-size: 18px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* 标题区域 */
.title-area {
    margin-top: 30px;
    margin-bottom: 20px;
    align-items: center;
    flex-direction: row;
}

.title-text {
    font-size: 36px;
    -unity-font-style: bold;
    flex-direction: row;
}

.title-black {
    color: rgb(0, 0, 0);
}

.title-red {
    color: rgb(255, 0, 0);
}

/* 说明文字 */
.description-area {
    align-items: center;
    margin-bottom: 40px;
}

.description-line1,
.description-line2 {
    font-size: 20px;
    color: rgb(150, 150, 150);
    -unity-text-align: middle-center;
    margin: 5px 0;
}

/* OK按钮 */
.ok-button {
    width: 200px;
    height: 60px;
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    border-radius: 30px;
    border-width: 0;
    margin-bottom: 30px;
}

.ok-button:hover {
    background-color: rgb(40, 40, 40);
}

/* 不再显示区域 */
.dont-show-area {
    flex-direction: row;
    align-items: center;
    position: absolute;
    bottom: 25px;
}

.dont-show-text {
    font-size: 16px;
    color: rgb(150, 150, 150);
    -unity-font-style: italic;
    margin-right: 10px;
}

/* 复选框 */
.checkbox {
    width: 28px;
    height: 28px;
    background-color: rgb(100, 255, 100);
    border-radius: 14px;
    align-items: center;
    justify-content: center;
}

.checkmark {
    font-size: 18px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    display: none;
}

.checkbox.checked .checkmark {
    display: flex;
}
