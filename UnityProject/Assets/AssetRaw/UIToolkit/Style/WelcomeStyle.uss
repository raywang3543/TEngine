/* ═══════════════════════════════════════════════════
   Y2K MBTI — Welcome Screen (欢迎页)
   Unity UI Toolkit / USS  ·  Unity 2021.3
   ═══════════════════════════════════════════════════ */

/* ── Design tokens ── */
:root {
    --bg:        #FFF5E1;
    --ink:       #0E0E12;
    --ink-2:     #2A2A33;
    --accent:    #C6FF3D;   /* acid lime  */
    --accent-2:  #FF5EA8;   /* bubble pink */
    --accent-3:  #3D6BFF;   /* cyber blue  */
    --chip-bg:   #EDE4CE;
    --card-bg:   #FFFFFF;
    --line:      #0E0E12;
}


/* ══════════════════════════════════════════════════
   ROOT
   ══════════════════════════════════════════════════ */

.welcome-root {
    width: 100%;
    height: 100%;
    background-color: #FFF5E1;
    position: relative;
    overflow: hidden;
}


/* ══════════════════════════════════════════════════
   BACKGROUND DECORATIONS  (absolute, behind content)
   ══════════════════════════════════════════════════ */

/* Large pink blob — top-right corner, partially clipped */
.bg-blob-pink {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 240px;
    height: 240px;
    border-radius: 120px;
    background-color: rgba(255, 94, 168, 0.35);
}

/* Lime blob — fully visible, left of centre */
.bg-blob-lime {
    position: absolute;
    top: 90px;
    left: 16px;
    width: 150px;
    height: 150px;
    border-radius: 75px;
    background-color: rgba(198, 255, 61, 0.50);
}

/* Subtle dot-grid texture overlay */
.bg-dots {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.12;
    /* Dot pattern approximated via a repeating radial-gradient tint.
       A proper dot texture asset can replace this background-color. */
    background-color: rgba(14, 14, 18, 0.08);
}


/* ══════════════════════════════════════════════════
   CONTENT LAYER  (absolute fill, on top of blobs)
   ══════════════════════════════════════════════════ */

.welcome-content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 22px 20px 22px;
    flex-direction: column;
    align-items: stretch;
}


/* ══════════════════════════════════════════════════
   TOP BAR
   ══════════════════════════════════════════════════ */

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.chip {
    background-color: #EDE4CE;
    border-width: 1.5px;
    border-color: #0E0E12;
    border-radius: 999px;
    padding: 6px 12px 6px 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #0E0E12;
    -unity-text-align: middle-center;
}

.est-label {
    font-size: 11px;
    color: rgba(14, 14, 18, 0.65);
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-right;
}


/* ══════════════════════════════════════════════════
   HERO SECTION
   ══════════════════════════════════════════════════ */

.hero {
    flex-direction: column;
    align-items: flex-start;
    margin-top: 40px;
    flex-shrink: 0;
}

.subtitle-mono {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(14, 14, 18, 0.65);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Big display title: "你是 / 哪一种" */
.hero-title {
    font-size: 64px;
    line-height: 59px;           /* 0.92 × 64 = 58.9 → tight stacking */
    color: #0E0E12;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: upper-left;
    margin-top: 14px;
    letter-spacing: -2px;
}

/* Inverted box: black background, slightly rotated */
.hero-highlight-box {
    background-color: #0E0E12;
    padding: 0px 10px 0px 10px;
    align-self: flex-start;
    rotate: -2deg;
    margin-top: 1px;
}

.hero-highlight-text {
    font-size: 64px;
    line-height: 59px;
    color: #FFF5E1;
    -unity-font-style: bold;
    letter-spacing: -2px;
    -unity-text-align: upper-left;
    white-space: nowrap;
}

/* Body copy under the title */
.hero-desc {
    font-size: 15px;
    line-height: 23px;           /* 1.55 × 15 = 23.25 */
    color: #2A2A33;
    margin-top: 20px;
    white-space: normal;
    -unity-text-align: upper-left;
    max-width: 300px;
    flex-shrink: 0;
}


/* ══════════════════════════════════════════════════
   STATS BADGE  (card with chunky border)
   ══════════════════════════════════════════════════ */

.stats-badge {
    flex-direction: row;
    align-items: center;
    margin-top: 28px;
    margin-bottom: 10px;
    padding: 14px 16px 14px 16px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-color: #0E0E12;
    border-radius: 16px;
    flex-shrink: 0;
}

/* Blue square with rounded corners holding the star */
.star-badge {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background-color: #3D6BFF;
    border-width: 2px;
    border-color: #0E0E12;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.star-icon-label {
    font-size: 20px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.stats-info {
    flex: 1;
    flex-direction: column;
}

.stats-main {
    font-size: 14px;
    -unity-font-style: bold;
    color: #0E0E12;
    -unity-text-align: upper-left;
    white-space: normal;
}

.stats-sub {
    font-size: 11px;
    color: rgba(14, 14, 18, 0.65);
    margin-top: 2px;
    -unity-text-align: upper-left;
    white-space: normal;
    letter-spacing: 0px;
}


/* ══════════════════════════════════════════════════
   BUTTONS  (Y2K chunky pill style)
   ══════════════════════════════════════════════════ */

.btn {
    width: 100%;
    border-radius: 999px;
    padding: 14px 22px 14px 22px;
    font-size: 16px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    border-width: 2px;
    border-color: #0E0E12;
    cursor: link;
    flex-shrink: 0;
    transition-property: translate;
    transition-duration: 0.08s;
}

/* Primary — acid lime */
.btn-primary {
    background-color: #C6FF3D;
    color: #0E0E12;
}

.btn-primary:hover {
    background-color: #B8F030;
}

.btn-primary:active {
    translate: 2px 2px;
    background-color: #AADF20;
}

/* Ghost — cream fill with outline */
.btn-ghost {
    background-color: #FFF5E1;
    color: #0E0E12;
}

.btn-ghost:hover {
    background-color: rgba(14, 14, 18, 0.06);
}

.btn-ghost:active {
    translate: 2px 2px;
}


/* ══════════════════════════════════════════════════
   MARQUEE STRIP  (scrolling MBTI types)
   ══════════════════════════════════════════════════ */

/* Outer pill: black bg, border, clips the track inside */
.marquee-strip {
    margin-top: 16px;
    height: 40px;
    overflow: hidden;
    border-radius: 999px;
    border-width: 2px;
    border-color: #0E0E12;
    background-color: #0E0E12;
    flex-shrink: 0;
    align-items: center;
}

/* Inner track: holds two copies of the label side-by-side.
   C# animates its translate-x each frame for smooth looping. */
.marquee-track {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    align-items: center;
    height: 40px;
}

.marquee-text {
    font-size: 12px;
    color: #FFF5E1;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: nowrap;
    -unity-text-align: middle-left;
    flex-shrink: 0;
    padding: 0px 0px 0px 0px;
}
