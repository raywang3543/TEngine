:root {
    --cream: #f6e8c8;
    --cream-light: #fff8e8;
    --ink: #17131f;
    --ink-soft: #30283d;
    --wine: #681a38;
    --pink: #ff5d8f;
    --blue: #557fff;
    --gold: #ffc857;
    --mint: #aeeecf;
    --felt: #14554b;
    --paper: #fffaf0;
    --line: rgba(23, 19, 31, 0.28);
    --muted: rgba(23, 19, 31, 0.58);
}

.carnival-root {
    width: 100%;
    height: 100%;
    min-width: 1280px;
    min-height: 590px;
    position: relative;
    overflow: hidden;
    background-color: #21142c;
    color: var(--ink);
}

.shader-effect {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: white;
}

.ambient-effect {
    opacity: 0.72;
    -unity-material: url("project://database/Assets/AssetRaw/Materials/CarnivalUIEffects.mat");
}

.screen-sheen-effect {
    opacity: 0.09;
    border-radius: 36px;
    -unity-material: url("project://database/Assets/AssetRaw/Materials/CarnivalUIEffects.mat");
}

.felt-effect {
    opacity: 0.24;
    -unity-material: url("project://database/Assets/AssetRaw/Materials/CarnivalFeltUIEffects.mat");
}

.backdrop-ring {
    position: absolute;
    border-width: 110px;
    border-color: rgba(255, 200, 87, 0.1);
    border-radius: 999px;
}

.backdrop-ring-a {
    width: 840px;
    height: 840px;
    top: -500px;
    right: -180px;
}

.backdrop-ring-b {
    width: 620px;
    height: 620px;
    bottom: -390px;
    left: -170px;
    border-color: rgba(255, 93, 143, 0.1);
}

.screen {
    position: absolute;
    top: 42px;
    right: 56px;
    bottom: 42px;
    left: 56px;
    padding: 32px 42px 36px 42px;
    background-color: var(--cream);
    border-width: 4px;
    border-color: var(--ink);
    border-radius: 40px;
    transition-property: filter;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.carnival-root-overlay-open .screen {
    filter: blur(5px) grayscale(22%) contrast(86%);
}

.top-bar,
.section-heading,
.score-line,
.result-strip,
.sort-row,
.action-row,
.overlay-actions {
    flex-direction: row;
    align-items: center;
}

.top-bar {
    height: 92px;
    flex-shrink: 0;
    justify-content: space-between;
    border-bottom-width: 2px;
    border-bottom-color: rgba(23, 19, 31, 0.18);
}

.brand-lockup {
    width: 430px;
}

.brand-kicker,
.panel-eyebrow,
.section-title,
.section-meta,
.metric-label,
.overlay-kicker,
.shop-rarity {
    font-size: 18px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.brand-kicker {
    color: var(--pink);
}

.brand-title {
    margin-top: -4px;
    font-size: 44px;
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.round-chip {
    height: 58px;
    min-width: 340px;
    padding: 11px 26px 11px 26px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--ink);
    border-radius: 29px;
}

.live-dot {
    margin-right: 15px;
    color: var(--pink);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.round-label {
    height: 36px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.quiet-button,
.mini-button {
    color: var(--ink);
    background-color: rgba(23, 19, 31, 0.04);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 10px;
    -unity-font-style: bold;
    transition-property: filter, translate;
    transition-duration: 120ms, 120ms;
}

.quiet-button {
    width: 180px;
    height: 54px;
    font-size: 20px;
}

.quiet-button:hover,
.mini-button:hover {
    background-color: var(--gold);
    border-color: var(--ink);
    filter: contrast(118%) tint(#fff1c2);
}

.performer-section {
    height: 222px;
    flex-shrink: 0;
    margin-top: 15px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(23, 19, 31, 0.16);
}

.section-heading {
    height: 32px;
    flex-shrink: 0;
    justify-content: space-between;
}

.section-title {
    color: var(--wine);
}

.section-meta {
    color: rgba(23, 19, 31, 0.52);
}

.loadout-row {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
    flex-direction: row;
}

.performer-row {
    flex-grow: 1;
    min-width: 0;
    height: 168px;
    flex-direction: row;
    justify-content: center;
}

.performer-card {
    width: 210px;
    height: 160px;
    margin: 0 10px 0 10px;
    padding: 14px;
    position: relative;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--paper);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 16px;
    transition-property: filter, translate;
    transition-duration: 140ms, 140ms;
    transition-timing-function: ease-out, ease-out;
}

.performer-card:hover {
    translate: 0 -6px;
    filter: contrast(112%) tint(#fff0d3);
}

.performer-tone-0 {
    background-color: #ffd2e0;
}

.performer-tone-1 {
    background-color: #ffe6a2;
}

.performer-tone-2 {
    background-color: #cfe3ff;
}

.performer-tone-3 {
    background-color: #c9efd9;
}

.performer-number {
    position: absolute;
    top: 10px;
    left: 13px;
    font-size: 15px;
    color: rgba(23, 19, 31, 0.48);
    -unity-font-style: bold;
}

.performer-icon {
    font-size: 58px;
    -unity-font-style: bold;
}

.performer-name {
    margin-top: 5px;
    font-size: 19px;
    -unity-font-style: bold;
}

.performer-empty {
    color: rgba(23, 19, 31, 0.28);
    background-color: rgba(255, 255, 255, 0.24);
    border-color: rgba(23, 19, 31, 0.22);
    font-size: 48px;
}

.consumable-heading {
    height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
}

.consumable-panel {
    width: 500px;
    height: 168px;
    margin-left: 22px;
    padding: 15px 18px 15px 18px;
    background-color: rgba(255, 255, 255, 0.32);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 14px;
}

.consumable-row {
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
}

.consumable-button {
    height: 51px;
    margin-bottom: 7px;
    padding: 0 18px 0 18px;
    color: var(--ink);
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 9px;
    font-size: 17px;
    -unity-font-style: bold;
    transition-property: filter, translate;
    transition-duration: 120ms, 120ms;
}

.consumable-button:hover {
    translate: 0 -2px;
    filter: contrast(116%);
}

.consumable-tarot {
    background-color: #ffd2e0;
}

.consumable-planet {
    background-color: #cfe2ff;
}

.consumable-spectral {
    background-color: #d8d0e3;
}

.consumable-empty {
    color: rgba(23, 19, 31, 0.45);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.main-grid {
    flex-grow: 1;
    min-height: 0;
    margin-top: 18px;
    flex-direction: row;
}

.panel {
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 22px;
}

.score-panel {
    width: 420px;
    flex-shrink: 0;
    margin-right: 24px;
    padding: 24px 26px 22px 26px;
    background-color: #fff8e8;
}

.blind-eyebrow {
    color: var(--wine);
}

.blind-label {
    margin-top: 5px;
    color: var(--wine);
    font-size: 34px;
    -unity-font-style: bold;
}

.blind-rule-label {
    min-height: 46px;
    margin-top: 2px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 18px;
    line-height: 24px;
    white-space: normal;
}

.panel-eyebrow {
    color: rgba(23, 19, 31, 0.54);
}

.score-eyebrow {
    margin-top: 2px;
}

.score-line {
    height: 76px;
    flex-shrink: 0;
}

.score-value {
    font-size: 60px;
    -unity-font-style: bold;
    color: var(--wine);
}

.score-target {
    margin-left: 10px;
    margin-top: 17px;
    font-size: 27px;
    color: rgba(23, 19, 31, 0.52);
    -unity-font-style: bold;
}

.progress-track {
    height: 16px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgba(23, 19, 31, 0.11);
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 8px;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: white;
    -unity-material: url("project://database/Assets/AssetRaw/Materials/CarnivalAccentUIEffects.mat");
}

.metric-grid {
    margin-top: 17px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.metric-box {
    width: 174px;
    height: 79px;
    margin-bottom: 12px;
    padding: 9px 14px 8px 14px;
    flex-shrink: 0;
    justify-content: center;
    overflow: hidden;
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 12px;
}

.metric-pink {
    background-color: #ffd2e0;
}

.metric-blue {
    background-color: #cfe2ff;
}

.metric-gold {
    background-color: #ffe5a0;
}

.metric-ink {
    background-color: #d8d0e3;
}

.metric-label {
    height: 23px;
    flex-shrink: 0;
    font-size: 17px;
    letter-spacing: 2px;
    color: rgba(23, 19, 31, 0.6);
    -unity-text-align: middle-left;
}

.metric-value {
    height: 31px;
    flex-shrink: 0;
    margin-top: 1px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.skip-blind-button {
    height: 52px;
    margin-top: 4px;
    flex-shrink: 0;
    color: var(--ink);
    background-color: var(--gold);
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    transition-property: filter, translate;
    transition-duration: 120ms, 120ms;
}

.skip-blind-button:hover {
    translate: 0 -2px;
    filter: contrast(116%) tint(#fff0b7);
}

.table-panel {
    flex-grow: 1;
    min-width: 0;
    padding: 18px 26px 20px 26px;
    background-color: var(--paper);
}

.result-strip {
    height: 78px;
    flex-shrink: 0;
    justify-content: space-between;
}

.result-copy {
    justify-content: center;
}

.result-eyebrow {
    font-size: 15px;
}

.hand-name {
    margin-top: -2px;
    color: var(--wine);
    font-size: 31px;
    -unity-font-style: bold;
}

.formula-label {
    margin-top: -3px;
    font-size: 19px;
    color: var(--muted);
}

.mini-button {
    width: 126px;
    height: 46px;
    margin-left: 10px;
    font-size: 18px;
}

.felt {
    flex-grow: 1;
    min-height: 390px;
    margin-top: 5px;
    position: relative;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: var(--felt);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 28px;
}

.felt-mark {
    position: absolute;
    width: 280px;
    height: 280px;
    border-width: 42px;
    border-color: rgba(255, 255, 255, 0.045);
    border-radius: 140px;
}

.felt-mark-left {
    left: -105px;
    bottom: -105px;
}

.felt-mark-right {
    right: -105px;
    top: -105px;
}

.card-row {
    width: 100%;
    padding: 52px 24px 28px 24px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.playing-card {
    width: 142px;
    height: 218px;
    margin: 0 9px 0 9px;
    padding: 13px;
    position: relative;
    flex-shrink: 0;
    align-items: flex-start;
    background-color: #fffdf7;
    color: #16131c;
    border-width: 3px;
    border-color: #16131c;
    border-radius: 13px;
    transition-property: filter, translate;
    transition-duration: 120ms, 120ms;
    transition-timing-function: ease-out, ease-out;
}

.playing-card:hover {
    translate: 0 -12px;
    background-color: #ffffff;
    filter: contrast(116%) tint(#fff7df);
}

.playing-card-selected {
    translate: 0 -25px;
    border-width: 5px;
    border-color: var(--gold);
    background-color: #fff1bd;
    filter: contrast(128%) tint(#ffe89a);
}

.playing-card-enhanced {
    border-color: var(--blue);
    background-color: #edf4ff;
    filter: contrast(112%) tint(#d9e8ff);
}

.playing-card-red {
    color: #cf2852;
}

.card-rank {
    font-size: 34px;
    -unity-font-style: bold;
}

.card-suit {
    margin-top: 27px;
    align-self: center;
    font-size: 58px;
    -unity-font-style: bold;
}

.card-rank-bottom {
    position: absolute;
    right: 13px;
    bottom: 10px;
    font-size: 27px;
    -unity-font-style: bold;
    rotate: 180deg;
}

.status-label {
    height: 34px;
    margin-top: 5px;
    flex-shrink: 0;
    color: rgba(23, 19, 31, 0.66);
    font-size: 19px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.action-row {
    height: 76px;
    flex-shrink: 0;
    justify-content: center;
}

.action-button {
    height: 66px;
    padding: 0 38px 0 38px;
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 12px;
    font-size: 22px;
    -unity-font-style: bold;
    transition-property: filter, translate;
    transition-duration: 120ms, 120ms;
}

.action-button:hover {
    translate: 0 -3px;
    filter: contrast(118%) tint(#fff0c2);
}

.action-button:active {
    translate: 3px 3px;
    filter: contrast(92%);
}

.action-button:disabled {
    filter: grayscale(85%) opacity(55%);
}

.action-secondary {
    width: 250px;
    margin-right: 16px;
    background-color: #eee2cc;
    color: var(--ink);
}

.action-primary {
    min-width: 330px;
    background-color: var(--pink);
    color: var(--ink);
}

.action-primary:hover {
    background-color: #ff7ba3;
}

.overlay {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 74px 100px 74px 100px;
    align-items: center;
    justify-content: center;
    background-color: rgba(23, 19, 31, 0.88);
}

.overlay-card {
    padding: 42px 48px 42px 48px;
    background-color: var(--cream);
    border-width: 4px;
    border-color: var(--ink);
    border-radius: 30px;
}

.shop-window {
    width: 2260px;
    max-height: 1030px;
}

.overlay-kicker {
    color: var(--pink);
}

.overlay-title {
    margin-top: 2px;
    font-size: 52px;
    -unity-font-style: bold;
}

.overlay-copy {
    margin-top: 9px;
    color: rgba(23, 19, 31, 0.64);
    font-size: 20px;
    line-height: 28px;
    white-space: normal;
}

.shop-offers {
    height: 460px;
    margin-top: 28px;
    flex-direction: row;
    justify-content: center;
}

.shop-card {
    width: 390px;
    margin: 0 12px 0 12px;
    padding: 24px;
    align-items: center;
    background-color: var(--paper);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 18px;
    transition-property: filter, translate;
    transition-duration: 140ms, 140ms;
}

.booster-pack-card {
    background-color: #eee5ff;
}

.booster-choice-card {
    width: 480px;
}

.booster-skip-card {
    width: 300px;
    justify-content: center;
}

.shop-card:hover {
    translate: 0 -7px;
    filter: contrast(110%) tint(#fff4d8);
}

.shop-rarity {
    align-self: flex-start;
    color: var(--wine);
}

.shop-icon {
    margin-top: 12px;
    font-size: 72px;
    -unity-font-style: bold;
}

.shop-name {
    font-size: 28px;
    -unity-font-style: bold;
}

.shop-description {
    flex-grow: 1;
    margin-top: 12px;
    color: rgba(23, 19, 31, 0.68);
    font-size: 19px;
    line-height: 27px;
    white-space: normal;
    -unity-text-align: upper-center;
}

.shop-buy-button {
    width: 100%;
    height: 58px;
    background-color: var(--gold);
    color: var(--ink);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 10px;
    font-size: 20px;
    -unity-font-style: bold;
    transition-property: filter;
    transition-duration: 120ms;
}

.shop-buy-button:hover {
    background-color: #ffd982;
    filter: contrast(120%) tint(#fff0ae);
}

.shop-buy-button:disabled {
    filter: grayscale(100%) opacity(50%);
}

.overlay-actions {
    margin-top: 26px;
    justify-content: space-between;
}

.shop-hint {
    color: rgba(23, 19, 31, 0.55);
    font-size: 18px;
}

.shop-reroll-button {
    min-width: 180px;
    background-color: var(--paper);
    color: var(--ink);
    border-width: 3px;
    border-color: var(--ink);
}

.performer-actions {
    margin-top: 5px;
    flex-direction: row;
    justify-content: center;
}

.performer-mini-button {
    min-width: 24px;
    height: 24px;
    margin: 0 2px;
    padding: 0;
    font-size: 11px;
    border-width: 1px;
    border-color: var(--ink);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.7);
}

.end-window {
    width: 920px;
    align-items: center;
}

.end-title {
    margin-top: 10px;
    font-size: 82px;
    -unity-font-style: bold;
}

.end-copy {
    margin-top: 18px;
    font-size: 23px;
    -unity-text-align: upper-center;
}

.end-button {
    margin-top: 34px;
}
